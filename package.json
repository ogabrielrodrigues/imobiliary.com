{
  "name": "imobiliary",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter ./docs dev",
    "build": "pnpm --filter ./docs build",
    "typecheck": "pnpm --filter ./docs typecheck",
    "test": "pnpm --filter ./docs test",
    "api:dev": "cd docgen-api && go run ./cmd/docgen",
    "api:build": "cd docgen-api && go build ./...",
    "api:test": "cd docgen-api && go test ./...",
    "api:test:integration": "cd docgen-api && go test -tags=integration ./..."
  }
}
