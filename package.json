{
  "name": "imobiliary",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "pnpm --filter ./docs dev",
    "docs:build": "pnpm --filter ./docs build",
    "docs:typecheck": "pnpm --filter ./docs typecheck",
    "docs:test": "pnpm --filter ./docs test",
    "docs:check": "pnpm --filter ./docs check",
    "docgen:dev": "cd docgen-api && go run ./cmd/docgen",
    "docgen:build": "cd docgen-api && go build ./...",
    "docgen:test": "cd docgen-api && go test ./...",
    "docgen:test:integration": "cd docgen-api && go test -tags=integration ./...",
    "security": "node scripts/security.mjs"
  }
}
