# Copy to .env and fill in. The service refuses to start without the database
# URL and the two kinds of key; none of them has a default.
#
# Passwords do not belong here. Leave them out of the URLs and put them in
# %APPDATA%\postgresql\pgpass.conf (or ~/.pgpass), which pgx reads:
#   localhost:5432:imobiliary:imobiliary_app:<password>

# The service connects as the application role.
IMOBILIARY_DATABASE_URL=postgres://imobiliary_app@localhost:5432/imobiliary?sslmode=disable

# The migrate command connects as the schema owner.
IMOBILIARY_MIGRATION_DATABASE_URL=postgres://imobiliary_owner@localhost:5432/imobiliary?sslmode=disable

# Integration tests connect to the maintenance database as the test role.
IMOBILIARY_TEST_DATABASE_URL=postgres://imobiliary_test@localhost:5432/postgres?sslmode=disable

# Keys sealing personal data. Each is the base64 of exactly 32 random bytes,
# which is 44 characters ending in "=". Generate one with either of:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# A single key may be written on its own, as below, and is read as version 1.
# Several are written as <version>:<key>, comma separated, for example
# "1:<old>,2:<new>": the highest version seals new values and the older ones
# stay to read what they sealed.
IMOBILIARY_FIELD_KEYS=

# Blind-index key, base64 of 32 bytes, generated the same way and never
# prefixed with a version: it cannot be rotated without recomputing every
# index, so generate it once and keep it.
IMOBILIARY_INDEX_KEY=

# Optional overrides.
# IMOBILIARY_ADDR=127.0.0.1:8081
# IMOBILIARY_METRICS_ADDR=127.0.0.1:9181
# IMOBILIARY_TRUST_PROXY_HEADERS=false
# IMOBILIARY_LOG_LEVEL=info
# IMOBILIARY_MAX_REQUEST_BYTES=1048576
# IMOBILIARY_SHUTDOWN_TIMEOUT=15s
