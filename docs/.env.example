# Copy to .env and fill in.
#
# The platform refuses to start without a session secret, and there is
# deliberately no default: one shared by every deployment that forgot to set it
# would be worse than none.
#
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Where the docgen API lives. It is never exposed to the browser — every call
# goes through a server function.
DOCGEN_API_URL=http://localhost:8080

# Only turn this on when a trusted proxy in front of this server sets
# X-Forwarded-For. When the platform is the edge, the socket address is the
# truth and the header is forgeable, which would let a client choose the
# address the API rate-limits it by.
# TRUST_PROXY_HEADERS=false
