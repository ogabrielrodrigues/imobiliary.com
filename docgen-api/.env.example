# Copy to .env and fill in. The service refuses to start without a secret of at
# least 32 bytes, and there is deliberately no default: a shared default secret
# would be worse than none at all.
#
# Generate one with:  openssl rand -base64 48
DOCGEN_JWT_SECRET=

# Optional overrides; see README.md for the full list and defaults.
# DOCGEN_ADDR=:8080
# DOCGEN_DB_PATH=data/docgen.db
# DOCGEN_BLOB_DIR=data/blobs
# DOCGEN_TRUST_PROXY_HEADERS=false
