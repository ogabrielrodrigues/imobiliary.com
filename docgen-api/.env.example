# Copy to .env and fill in. The service refuses to start without a secret of at
# least 32 bytes, and there is deliberately no default: a shared default secret
# would be worse than none at all.
#
# Generate one with:  openssl rand -base64 48
DOCGEN_JWT_SECRET=

# Optional overrides; see README.md for the full list and defaults.
# DOCGEN_ADDR=127.0.0.1:8080
# DOCGEN_DB_PATH=data/docgen.db
# DOCGEN_BLOB_DIR=data/blobs
# DOCGEN_TRUST_PROXY_HEADERS=false

# Where the platform is served. The password-reset mail builds its link from
# this, and it is the only URL the API needs to know.
# DOCGEN_APP_URL=http://localhost:3000

# One of these two is required, or the service refuses to start.
#
# In development, declare DOCGEN_MAIL_LOG=true: mail is written to the log
# instead of sent, so the reset link appears in the terminal and nothing can
# reach a real inbox. NEVER set it in production — the log would then hold a
# working password-reset link for any account anyone asks about.
DOCGEN_MAIL_LOG=true
# DOCGEN_RESEND_API_KEY=
# DOCGEN_MAIL_FROM=Imobiliary Docs <nao-responda@imobiliary.com>
# DOCGEN_PASSWORD_RESET_TTL=30m
