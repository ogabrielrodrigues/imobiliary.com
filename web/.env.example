# Copy to .env and fill in. The platform refuses to start without a session
# secret: a shared default would be worse than none at all.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Where the API lives. It is never exposed to the browser.
# IMOBILIARY_API_URL=http://127.0.0.1:8081

# Public address of this deployment, baked into the bundle for canonical links,
# Open Graph and the sitemap.
# VITE_SITE_URL=https://imobiliary.com

# Only when a proxy in front sets X-Forwarded-For, and only then.
# TRUST_PROXY_HEADERS=false
# TRUSTED_ORIGIN=https://imobiliary.com
